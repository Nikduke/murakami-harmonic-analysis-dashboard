# Conda and virtual environments
.conda/
.venv/
venv/
env/

# Python caches and test artifacts
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Local configuration and credentials
.env
.env.*
!.env.example
.streamlit/secrets.toml
secrets.toml
credentials.json
